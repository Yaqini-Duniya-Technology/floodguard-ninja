# Configure on hosting platform; do not commit actual secrets.
FLOODGUARD_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
# Use persistent disk for SQLite or migrate to managed Postgres before production.
FLOODGUARD_DB_PATH=/var/data/floodguard.sqlite3
NIPOST_INTEGRATION_ENABLED=false
NIPOST_CONTRACT_VERIFIED=false
NIPOST_ALLOWED_HOST=
NIPOST_LOOKUP_URL=
NIPOST_API_KEY=
FLOODGUARD_ENV=production
