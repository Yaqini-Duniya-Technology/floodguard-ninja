FLOODGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FLOODGUARD_DB_PATH=./floodguard.sqlite3
# NIPOST L1 sandbox: do not commit a real secret. Configure on backend only.
NIPOST_INTEGRATION_ENABLED=false
NIPOST_API_KEY=

# Set true only after verifying persistent storage, backups and incident response.
FLOODGUARD_REPORTING_ENABLED=false
